# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your iCal calendar URL (e.g. from Google Calendar, Apple iCloud, etc.)
# In Google Calendar: Settings → your calendar → "Secret address in iCal format"
# In iCloud: Calendar → share calendar → copy link (change webcal:// → https://)
ICAL_URL=https://calendar.google.com/calendar/ical/your_calendar_id/basic.ics

# Apple Reminders list name to read from (default: "Booking Tasks")
REMINDERS_LIST=Booking Tasks

# Scheduling window (24-hour format)
SCHEDULE_WINDOW_START=9
SCHEDULE_WINDOW_END=18

# Travel/buffer time in minutes between appointments
BUFFER_MINUTES=30

# Number of days ahead to scan for availability
LOOKAHEAD_DAYS=30

# Output file path (optional override)
# OUTPUT_PATH=/Users/brewdio/Desktop/Dev/scheduler-agent/outputs/action_plan.json
